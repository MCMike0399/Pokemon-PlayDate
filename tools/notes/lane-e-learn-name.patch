+function LearningState:visiblePrompt()
+    -- pokered cont after "trying to learn" scrolls that row up and prints
+    -- the move name on the second text-box line. The box is two rows.
+    local rows = {}
+    for row in (self.prompt .. "\n"):gmatch("(.-)\n") do rows[#rows + 1] = row end
+    for index, row in ipairs(rows) do
+        if row:find("trying to learn", 1, true) and rows[index + 1] then
+            return rows[index] .. "\n" .. rows[index + 1]
+        end
+    end
+    return self.prompt
+end
