-    assert(immutableDigest("sprites", "sprites", source), "unknown Blue source actor")
+    if not immutableDigest("sprites", "sprites", source) and not palletStrip(source) then
+        error("unknown Blue source actor")
+    end
     return "cerulean_" .. source:lower()
 end
 
