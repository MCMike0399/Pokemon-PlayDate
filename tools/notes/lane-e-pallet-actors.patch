+-- Pallet and Oak's Lab have no content-cache strip (install dies on a nil
+-- standing table). Red's house and Blue's house have no digest at all
+-- (unknown actor). These nine strips are read from the pinned zRemainder
+-- catalog only when the immutable lookup misses. Catalog hits still win.
+-- Elite Four, Colosseum and Trade Center actors are not included.
+local PALLET_ACTORS <const> = {
+    SPRITE_OAK = true, SPRITE_BLUE = true, SPRITE_SCIENTIST = true,
+    SPRITE_MOM = true, SPRITE_DAISY = true, SPRITE_GIRL = true,
+    SPRITE_FISHER = true, SPRITE_POKEDEX = true, SPRITE_POKE_BALL = true,
+}
+local palletSprites
+local function palletStrip(source)
+    if not PALLET_ACTORS[source] then return nil end
+    if not palletSprites then
+        local data = assert(json.decodeFile("data/zRemainder/sprites.json"), "missing Pallet sprite catalog")
+        assert(data.schema == 1 and data.source_revision == "af519899719f0754965776faac0e836a3b906e6d",
+            "unverified Pallet sprite catalog")
+        palletSprites = assert(data.sprites, "Pallet sprite catalog has no strips")
+    end
+    local strip = palletSprites[source]
+    if type(strip) ~= "table" then return nil end
+    if type(strip.walking) ~= "table" or next(strip.walking) == nil then
+        strip = copy(strip)
+        strip.walking = copy(strip.standing)
+        palletSprites[source] = strip
+    end
+    return strip
+end
 local function spriteRecord(source)
-    return assert(immutableLookup("sprites", "sprites", source), "missing Blue source sprite: " .. tostring(source))
+    local found = immutableLookup("sprites", "sprites", source)
+    if found then return found end
+    return assert(palletStrip(source), "missing Blue source sprite: " .. tostring(source))
 end
 
 function CeruleanContent.sprite(source)
