+++ b/Source/battle/spriteMask.lua
@@ -0,0 +1,35 @@
+-- Exterior white is the white that flood-fills in from the picture's edges.
+-- White enclosed by the silhouette stays opaque. The seen table is keyed
+-- by y * width + x and is true only for the transparent pixels.
+SpriteMask = {}
+
+function SpriteMask.exterior(width, height, isWhite)
+    local seen = {}
+    local stack = {}
+    local function consider(x, y)
+        if x < 0 or y < 0 or x >= width or y >= height then return end
+        local index = y * width + x
+        if seen[index] or not isWhite(x, y) then return end
+        seen[index] = true
+        stack[#stack + 1] = index
+    end
+    for x = 0, width - 1 do
+        consider(x, 0)
+        consider(x, height - 1)
+    end
+    for y = 0, height - 1 do
+        consider(0, y)
+        consider(width - 1, y)
+    end
+    while #stack > 0 do
+        local index = stack[#stack]
+        stack[#stack] = nil
+        local x = index % width
+        local y = (index - x) / width
+        consider(x + 1, y)
+        consider(x - 1, y)
+        consider(x, y + 1)
+        consider(x, y - 1)
+    end
+    return seen
+end
