+def _zone_door_table(text, start):
+    """Return the door-table body of a zone() call, or None when that call has no to= table."""
+    depth = 1
+    i = start
+    chosen = None
+    while i < len(text) and depth:
+        char = text[i]
+        if char == '(':
+            depth += 1
+        elif char == ')':
+            depth -= 1
+        elif char == '{' and depth == 1:
+            end = i + 1
+            nested = 1
+            while end < len(text) and nested:
+                if text[end] == '{':
+                    nested += 1
+                elif text[end] == '}':
+                    nested -= 1
+                end += 1
+            body = text[i + 1:end - 1]
+            if re.search(r'\bto\s*=', body):
+                if chosen is not None:
+                    raise ValueError('unsupported authored door syntax')
+                chosen = body
+            i = end - 1
+        i += 1
+    return chosen
+
