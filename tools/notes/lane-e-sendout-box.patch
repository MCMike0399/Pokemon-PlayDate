+
+-- A confirmed battle page stays on screen while the send-out ball plays.
+-- Dialog:draw returns once the page is dismissed, and the battle scene was
+-- repainting that same line with drawRect and the system font. This paints
+-- the finished page through TextBoxBorder and the pixel font without
+-- reopening the typewriter or accepting another confirm.
+function Dialog:drawSettled(text)
+    local savedActive = self.isActive
+    local savedLines = self.lines
+    local savedCurrent = self.currentLine
+    local savedIndex = self.charIndex
+    local savedArrows = self.arrows
+    self.isActive = true
+    self.lines = { text or "" }
+    self.currentLine = 1
+    self.charIndex = #(text or "")
+    self.arrows = { false }
+    self:draw()
+    self.isActive = savedActive
+    self.lines = savedLines
+    self.currentLine = savedCurrent
+    self.charIndex = savedIndex
+    self.arrows = savedArrows
+end
