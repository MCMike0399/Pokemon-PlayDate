+-- Standalone pdz. PauseState loads it with playdate.file.run("game/trainerScreen")
+-- while the trainer card is open and nils TrainerScreen when that card closes.
+-- The badge tiles stay out of a boot that never opens the card.
+--
+TrainerScreen = {}
+local gfx = playdate and playdate.graphics
+-- engine/menus/start_sub_menus.asm DrawTrainerInfo. The top box is 20 by 8
+-- tiles from hlcoord 0, 0. NAME/ MONEY/ TIME/ is PlaceString at hlcoord 2, 2.
+-- BADGES is TrainerInfo_BadgesText at hlcoord 6, 9, with circle tile $76
+-- on both sides (gfx/trainer_card/circle_tile.png). The side rails are
+-- TrainerInfo_DrawVerticalLine at columns 0 and 19.
+-- engine/menus/draw_badges.asm DrawBadges. Faces and badges are
+-- gfx/trainer_card/badges.png (badges.2bpp), eight leaders, face then
+-- badge. Numbers are gfx/trainer_card/badge_numbers.png. Unearned draws
+-- the face; earned adds 4 tile ids and draws the badge. Names in
+-- gfx/trainer_card/blank_leader_names.png are blank, so they are not drawn.
+-- Rows are hlcoord 2, 11 and hlcoord 2, 14, stride 4. The 2x2 graphic
+-- sits one column right and one row down. Text and these tiles use a
+-- uniform 12/8 scale inside the 20 by 13 cell; the 16x16 graphic is the
+-- same 3/2 scale (24px) so the face stays one piece.
+local TRAINER_FIT <const> = 12
+
+local function trainerFitTile(sheetName, index)
+    local sheet = GbFont.load()[sheetName]
+    local columns = sheetName == "ed" and 1 or 16
+    local sx = (index % columns) * 8
+    local sy = math.floor(index / columns) * 8
+    local image = gfx.image.new(TRAINER_FIT, TRAINER_FIT, gfx.kColorWhite)
+    gfx.pushContext(image)
+    gfx.setDrawOffset(0, 0)
+    gfx.setColor(gfx.kColorBlack)
+    for y = 0, TRAINER_FIT - 1 do
+        local sourceY = sy + math.floor(y * 8 / TRAINER_FIT)
+        for x = 0, TRAINER_FIT - 1 do
+            local sourceX = sx + math.floor(x * 8 / TRAINER_FIT)
+            if sheet:sample(sourceX, sourceY) == gfx.kColorBlack then
+                gfx.drawPixel(x, y)
+            end
+        end
+    end
+    gfx.popContext()
+    return image
+end
+
+local function trainerFitAt(sheetName, index, col, row)
+    local ox = math.floor((TitleIdle.COL - TRAINER_FIT) / 2)
+    local oy = TitleIdle.ROW - TRAINER_FIT
+    trainerFitTile(sheetName, index):draw(col * TitleIdle.COL + ox, row * TitleIdle.ROW + oy)
+end
+
+local function trainerFitChar(char, col, row)
+    local sheetName, index = TitleIdle.glyph(char)
+    trainerFitAt(sheetName, index, col, row)
+end
+
+local function trainerFitString(text, col, row)
+    local cursor, index = 0, 1
+    while index <= #text do
+        local nextIndex, sheetName, glyph = TitleIdle.nextTile(text, index)
+        trainerFitAt(sheetName, glyph, col + cursor, row)
+        cursor = cursor + 1
+        index = nextIndex
+    end
+end
