+local TRAINER_NUMBER_TILES <const> = {
+    {0x00,0x30,0x12,0x12,0x12,0x12,0x02,0x7e},
+    {0x00,0x70,0x12,0x72,0x42,0x72,0x02,0x7e},
+    {0x00,0x70,0x12,0x72,0x12,0x72,0x02,0x7e},
+    {0x00,0x50,0x52,0x72,0x12,0x12,0x02,0x7e},
+    {0x00,0x70,0x42,0x72,0x12,0x72,0x02,0x7e},
+    {0x00,0x70,0x42,0x72,0x52,0x72,0x02,0x7e},
+    {0x00,0x70,0x12,0x12,0x12,0x12,0x02,0x7e},
+    {0x00,0x70,0x52,0x72,0x52,0x72,0x02,0x7e}
+}
+local TRAINER_CIRCLE_TILE <const> = {0x00,0x00,0x38,0x7c,0x7c,0x7c,0x38,0x00}
+
+local function trainerBit(row, x)
+    return (row >> (7 - x)) & 1 == 1
+end
+
+local function trainerScaledTile(tile, dest)
+    local image = gfx.image.new(dest, dest, gfx.kColorWhite)
+    gfx.pushContext(image)
+    gfx.setColor(gfx.kColorBlack)
+    for y = 0, dest - 1 do
+        local sourceY = math.floor(y * 8 / dest)
+        local bits = tile[sourceY + 1]
+        for x = 0, dest - 1 do
+            if trainerBit(bits, math.floor(x * 8 / dest)) then gfx.drawPixel(x, y) end
+        end
+    end
+    gfx.popContext()
+    return image
+end
+
+local function trainerDrawTile(tile, col, row)
+    local ox = math.floor((TitleIdle.COL - 12) / 2)
+    local oy = TitleIdle.ROW - 12
+    trainerScaledTile(tile, 12):draw(col * TitleIdle.COL + ox, row * TitleIdle.ROW + oy)
+end
+
+local function trainerBadgeGraphic(leader, earned)
+    local base = (leader - 1) * 8 + (earned and 4 or 0)
+    local image = gfx.image.new(24, 24, gfx.kColorWhite)
+    gfx.pushContext(image)
+    gfx.setColor(gfx.kColorBlack)
+    for y = 0, 23 do
+        local sy = math.floor(y * 16 / 24)
+        for x = 0, 23 do
+            local sx = math.floor(x * 16 / 24)
+            local tile = TRAINER_BADGE_TILES[base + math.floor(sy / 8) * 2 + math.floor(sx / 8) + 1]
+            if trainerBit(tile[(sy % 8) + 1], sx % 8) then gfx.drawPixel(x, y) end
+        end
+    end
+    gfx.popContext()
+    return image
+end
+
+function TrainerScreen.draw(state)
+    local session = state.game.session
+    local clock = session:playTime()
+    local earned = {}
+    for index, id in ipairs(TitleIdle.BADGE_FLAGS) do
+        earned[index] = session:questFlag(id) == true
+    end
+    GbFont.drawBox(TitleIdle.textBox(0, 0, 18, 6))
+    GbFont.drawBox(TitleIdle.textBox(1, 10, 16, 6))
+    for row = 10, 17 do
+        GbFont.drawChar("│", 0, row)
+        GbFont.drawChar("│", 19, row)
+    end
+    trainerFitString("NAME/", 2, 2)
+    trainerFitString(Story.playerName(state.game), 7, 2)
+    trainerFitString("MONEY/", 2, 4)
+    trainerFitString("¥" .. session:inventory():money(), 8, 4)
+    trainerFitString("TIME/", 2, 6)
+    trainerFitString(TitleIdle.playTimeText(clock.hours, clock.minutes), 9, 6)
+    trainerDrawTile(TRAINER_CIRCLE_TILE, 6, 9)
+    trainerFitString("BADGES", 7, 9)
+    trainerDrawTile(TRAINER_CIRCLE_TILE, 13, 9)
+    for index = 1, 8 do
+        local col = 2 + ((index - 1) % 4) * 4
+        local row = index <= 4 and 11 or 14
+        trainerDrawTile(TRAINER_NUMBER_TILES[index], col, row)
+        local graphic = trainerBadgeGraphic(index, earned[index])
+        graphic:draw((col + 1) * TitleIdle.COL + 8, (row + 1) * TitleIdle.ROW + 1)
+    end
+    local pic = gfx.image.new("images/player/red-pic-front")
+    if pic then
+        local _, height = pic:getSize()
+        local target = 6 * TitleIdle.ROW
+        pic:drawScaled(15 * TitleIdle.COL, TitleIdle.ROW, target / height)
+    end
+end
+
+
+function TrainerScreen.release()
+end
