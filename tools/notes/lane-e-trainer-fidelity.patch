+-- engine/menus/start_sub_menus.asm DrawTrainerInfo. The top box is 20 by 8
+-- tiles from hlcoord 0, 0. NAME/ MONEY/ TIME/ is PlaceString at hlcoord 2, 2,
+-- so each label is two rows down. BADGES sits on the row between the boxes.
+-- The side rails are TrainerInfo_DrawVerticalLine at columns 0 and 19.
+function PauseState:drawTrainer()
+    local session = self.game.session
+    local clock = session:playTime()
+    GbFont.drawBox(TitleIdle.textBox(0, 0, 18, 6))
+    GbFont.drawBox(TitleIdle.textBox(1, 10, 16, 6))
+    for row = 10, 17 do
+        GbFont.drawChar("│", 0, row)
+        GbFont.drawChar("│", 19, row)
+    end
+    GbFont.drawString("NAME/", 2, 2)
+    GbFont.drawString(Story.playerName(self.game), 7, 2)
+    GbFont.drawString("MONEY/", 2, 4)
+    GbFont.drawString("¥" .. session:inventory():money(), 8, 4)
+    GbFont.drawString("TIME/", 2, 6)
+    GbFont.drawString(TitleIdle.playTimeText(clock.hours, clock.minutes), 9, 6)
+    GbFont.drawString("BADGES", 6, 9)
+    local pic = gfx.image.new("images/player/red-pic-front")
+    if pic then
+        local _, height = pic:getSize()
+        local target = 6 * TitleIdle.ROW
+        pic:drawScaled(15 * TitleIdle.COL, TitleIdle.ROW, target / height)
+    end
+end
+
 function PauseState:resume()
