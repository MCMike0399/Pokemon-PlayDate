+function Battle:deferAbilityLines(body)
+    -- Sturdy, Anger Point, Static, and Poison Point narrate during the hit.
+    -- Gen V prints the crit and effectiveness lines first, then the ability.
+    local held = self.deferredSecondaryLines
+    if not held then
+        held = {}
+        self.deferredSecondaryLines = held
+    end
+    local real = self.say
+    self.say = function(_, text) held[#held + 1] = text end
+    local ok, err = pcall(body)
+    self.say = real
+    if not ok then error(err, 0) end
+end
