diff --git a/Source/battle/battle.lua b/Source/battle/battle.lua
--- a/Source/battle/battle.lua
+++ b/Source/battle/battle.lua
@@ -1016,7 +1016,15 @@ function Battle:resolveRound(turns)
     self.effects:beginRound(turns)
     for _, turn in ipairs(turns) do
         local outcome = self:resolveTurn(turn)
-        if outcome and outcome ~= "replacement" then return outcome end
+        -- Recoil, Struggle, and confusion self-hits faint the actor after
+        -- that action resolved. handleFaint returns "replacement" while the
+        -- bench can still fight. The later queued action still has a living
