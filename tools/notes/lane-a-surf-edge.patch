+local surfSteps={up={0,-1},down={0,1},left={-1,0},right={1,0}}
+local function surfMapName(key)
+    if not SourceMaps or not SourceMaps.names then return nil end
+    for _, name in ipairs(SourceMaps.names()) do
+        if SourceMaps.entry(name).key == key then return name end
+    end
+end
+-- Surfing off a foot-$14 bank is not a blocked origin. Both cells have to be
+-- that water tile, and both tilesets have to accept the surf surface.
+-- Walking and every other collision-1 cell still return blocked-origin.
+local function surfingWaterDoor(game, zone, x, y, direction)
+    local step=surfSteps[direction]
+    if not step or not game or not game.session or not zone or not SourceMaps or not FieldTravel then return nil end
+    local travel=game.session.fieldTravelData and game.session:fieldTravelData()
+    if not travel or travel.mode~="surfing" then return nil end
+    local nextX,nextY=x+step[1],y+step[2]
+    if nextX>=0 and nextY>=0 and nextX<zone.width and nextY<zone.height then return nil end
+    local name=SourceMaps.nameForID(zone.stableID)
+    if not name then return nil end
+    local link=SourceMaps.connection(name, x, y, direction)
+    if not link then return nil end
+    local target=surfMapName(link.to)
+    if not target then return nil end
+    local origin=SourceMaps.cell(name, x, y).terrain
+    local arrival=SourceMaps.cell(target, link.x, link.y).terrain
+    local originSet=SourceMaps.descriptor(name).tileset.constant
+    local arrivalSet=SourceMaps.descriptor(target).tileset.constant
+    local function water(cell)
+        return cell and cell.water_candidate==true and cell.foot_tile==0x14
+    end
+    if not (water(origin) and water(arrival)) then return nil end
+    if not FieldTravel.surfSurface(origin, originSet) or not FieldTravel.surfSurface(arrival, arrivalSet) then return nil end
+    return {to=link.to,toX=link.x,toY=link.y,facing=link.facing,connection=true,source=link.source}
+end
