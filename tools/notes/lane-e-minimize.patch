diff --git a/Source/battle/battle.lua b/Source/battle/battle.lua
index 219755eb..ae5de78c 100644
--- a/Source/battle/battle.lua
+++ b/Source/battle/battle.lua
@@ -132,6 +132,13 @@ function calcDamage(attacker, defender, move, effectivePower, effects)
 
     -- Immune = 0 damage
     if effectiveness == 0 then damage = 0 end
+    -- Gen V Stomp doubles damage when the target has used Minimize.
+    -- Showdown's gen5 Minimize condition keeps onSourceModifyDamage and
+    -- drops the accuracy bypass. Body Slam gains that flag in Generation VI.
+    if damage > 0 and move.name == "STOMP" and defender and effects and effects.battle
+        and effects.battle.conditions:of(defender).minimize then
+        damage = damage * 2
+    end
 
     return {
         damage = damage,
diff --git a/Source/battle/dsl.lua b/Source/battle/dsl.lua
index 73e0d054..5f2c9e80 100644
--- a/Source/battle/dsl.lua
+++ b/Source/battle/dsl.lua
@@ -541,6 +541,12 @@ Class("RageEffect")
 function RageEffect:apply(battle) if battle.attacker:isAlive() then battle.conditions:of(battle.attacker).rage=true end end
 Class("DefenseCurlEffect")
 function DefenseCurlEffect:apply(battle) battle.conditions:of(battle.attacker).defenseCurl=true end
+-- Gen V Minimize is evasion +2 (the move's ModifyStat) plus the minimize flag.
+-- pokered StatModifierUpEffect EVASION_UP1_EFFECT is only +1.
+Class("MinimizeEffect")
+function MinimizeEffect:apply(battle)
+    battle.conditions:of(battle.attacker).minimize = true
+end
 Class("RapidSpinEffect")
 function RapidSpinEffect:apply(battle, _secondary, receipt)
     if receipt and receipt.substitute then return end
