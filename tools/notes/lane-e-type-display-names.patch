 EndgameStory = {}
 local CONTENT <const> = "endgame"
 local REVISION <const> = "af519899719f0754965776faac0e836a3b906e6d"
@@ -246,7 +249,14 @@ function EndgameStory.monTypes(species)
     if not types then
         return {}
     end
