+function LearningState:turnAskPage()
+    -- Same hold as the battle-message patch. The frame that reveals a page
+    -- does not accept A, and the page stays up for 10 frames. A hold that
+    -- began earlier has to last 12 frames after that before it turns the page.
+    if not self.askShown then
+        self.askShown = true
+        self.askFrames = 0
+        self.askHold = 0
+        return
+    end
+    self.askFrames = self.askFrames + 1
+    if self.askFrames < 10 then return end
+    local held = playdate.buttonIsPressed(playdate.kButtonA)
+    self.askHold = held and self.askHold + 1 or 0
+    if not playdate.buttonJustPressed(playdate.kButtonA) and self.askHold < 12 then return end
+    self.askPage = self.askPage + 1
+    self.askShown = false
+    self.askFrames = 0
+    self.askHold = 0
+    -- Leave viewGeneration alone. Bumping it invalidates the YES/NO
+    -- callback showAsk just installed, so NO on the last page does nothing.
+    gfx.sprite.addDirtyRect(0, 0, 400, 240)
+    if self.askPage >= #self.askPages then self.menu.isActive = true end
+end
