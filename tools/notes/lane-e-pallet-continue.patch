diff --git a/Source/world/sourceActors.lua b/Source/world/sourceActors.lua
index c4e5848b..e085992c 100644
--- a/Source/world/sourceActors.lua
+++ b/Source/world/sourceActors.lua
@@ -36,6 +36,23 @@ function SourceActors.wanders(movement, facing, boulder, trainer, item)
     local turnsInPlace = movement=="STAY" and not fixedFacing
     return (movement=="WALK" or turnsInPlace) and not boulder and not trainer and not item
 end
+-- Fixed-facing STAY used to be saved as a random delay. The only legal
+-- replacement is the object_event tile. A random actor, or a static pose,
+-- cannot be rewritten.
+function SourceActors.settled(saved, world, location)
+    assert(type(saved)=="table" and type(saved.id)=="string", "saved actor required")
+    assert(saved.phase=="delay" or saved.phase=="ready" or saved.phase=="moving",
+        "static actor was rewritten: "..saved.id)
+    assert(type(location)=="table", "candidate location required")
+    local descriptor=assert(SourceActors.describe(location.zone_id, world), "actor descriptor required for settle proof")
+    local spec
+    for _, candidate in ipairs(descriptor.actors) do
+        if candidate.id==saved.id then spec=candidate break end
+    end
+    assert(spec, "unknown stable source actor ID: "..saved.id)
+    assert(not spec.random, "random actor cannot leave its saved pose: "..saved.id)
+    return WorldMotionData.initial(spec)
+end
 -- Independent proof used by the session retention boundary. It re-resolves the
 -- candidate descriptor and flags and rejects both unknown and still-visible
 -- actors, so a custom validator cannot claim an arbitrary removal.
