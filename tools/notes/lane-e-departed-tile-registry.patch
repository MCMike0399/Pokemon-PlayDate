+local function mixIdentity(sum, value)
+    local kind = type(value)
+    if kind == "number" then
+        return (sum * 131 + math.floor(value * 1000)) % 2147483647
+    end
+    if kind == "string" then
+        for byte = 1, #value do
+            sum = (sum * 131 + string.byte(value, byte)) % 2147483647
+        end
+        return sum
+    end
+    if kind == "table" then
+        for index = 1, #value do
+            sum = mixIdentity(sum, value[index])
+        end
+        if value.p ~= nil then sum = mixIdentity(sum, value.p) end
+        if value.s ~= nil then sum = mixIdentity(sum, value.s) end
+        if value.v ~= nil then sum = mixIdentity(sum, value.v) end
+        return sum
+    end
+    return sum
+end
+
+-- Same file.run and bind as a first play. The warm's file.run installs the
+-- chunk; playback and this mix both go through ensureScore.
+function KantoSynth.identity(name)
+    local score = ensureScore(name)
+    if not score then
+        return "missing"
+    end
+    local count = noteCount(score)
+    local sum = (score.ticks or 0) + (score.loop or 0)
+    sum = (sum + count * 1000003) % 2147483647
+    for index = 1, count do
+        sum = mixIdentity(sum, noteAt(score, index))
+    end
+    return string.format("%d:%s:%d:%d", score.ticks or 0, tostring(score.loop or 0), count, sum)
+end
+
