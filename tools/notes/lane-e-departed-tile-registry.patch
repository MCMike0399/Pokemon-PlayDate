+-- file.run keeps each score chunk after the note table is cleared.
+-- The harness leaves the 9 MiB sample off, so it still loads every bed
+-- once, before the first measured floor. A player or device build is
+-- inside that sample. The full set crosses it, so those beds stay on
+-- the first-play path.
+local warmedStrings = false
+function SourceMaps._warmDepartedStrings()
+    if warmedStrings or recordOverrides then
+        return
+    end
+    warmedStrings = true
+    if BootTrace then
+        BootTrace.mark("registry.warm.begin")
+    end
+    -- memoryBudgetEnabled is on for a player build and a device build.
+    -- The harness sets HarnessBuild.enabled and leaves the sample off.
+    local budget = BootTrace and BootTrace.memoryBudgetEnabled and BootTrace.memoryBudgetEnabled()
+    if not budget and playdate.file.listFiles and KantoSynth and KantoSynth.unloadAll then
+        local listed = playdate.file.listFiles("audio/score") or {}
+        for _, file in ipairs(listed) do
+            local name = file:gsub("%.pdz$", ""):gsub("%.lua$", "")
+            if name ~= file and not name:find(".", 1, true) and name:sub(1, 5) ~= "move_" then
+                pcall(playdate.file.run, "audio/score/" .. name)
+                KantoSynth.unloadAll()
+            end
+        end
+    end
+    if BootTrace then
+        BootTrace.mark(budget and "registry.warm.deferred" or "registry.warm.end")
+    end
+end
+
 function SourceMaps.nameForID(id, profile)
