+-- Departed maps keep no registry rows. The next visit registers the same
+-- stable keys, in definition order, into the same slots above the base set.
+-- Numeric ids are local render slots; saves and journeys use the stable key.
+function TileRegistry:releaseDeparted()
+    local store = stores[self]
+    if not store then
+        return
+    end
+    for id = #store.entries, BASE_COUNT + 1, -1 do
+        local entry = store.entries[id]
+        if entry and entry.key then
+            store.keys[entry.key] = nil
+        end
+        store.entries[id] = nil
