@@ -52,15 +52,34 @@ function GbFont.drawChar(char, col, row)
 end
 
 function GbFont.drawString(text, col, row)
+    GbFont.drawStringAt(text, col * TitleIdle.COL, row * TitleIdle.ROW)
+end
+
+function GbFont.drawStringAt(text, x, y)
     local cursor, index = 0, 1
     while index <= #text do
         local nextIndex, sheetName, glyph = TitleIdle.nextTile(text, index)
-        tileImage(sheetName, glyph):draw((col + cursor) * TitleIdle.COL, row * TitleIdle.ROW)
+        tileImage(sheetName, glyph):draw(x + cursor * TitleIdle.COL, y)
         cursor = cursor + 1
         index = nextIndex
     end
 end
 
+function GbFont.drawCharAt(char, x, y)
+    local sheetName, index = TitleIdle.glyph(char)
+    tileImage(sheetName, index):draw(x, y)
+end
+
+function GbFont.tiles(text)
+    local count, index = 0, 1
+    while index <= #text do
+        local nextIndex = TitleIdle.nextTile(text, index)
+        count = count + 1
+        index = nextIndex
+    end
+    return count
+end
