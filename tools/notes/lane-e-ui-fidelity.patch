+-- engine/menus/start_sub_menus.asm DrawTrainerInfo places RedPicFront upper
+-- right, then NAME/ MONEY/ TIME/. engine/menus/draw_badges.asm DrawBadges
+-- draws four faces per row. An owned badge uses the graphic four tiles
+-- below that face in gfx/trainer_card/badges.png.
+function PauseState:drawTrainer()
+    local session = self.game.session
+    local clock = session:playTime()
+    gfx.setColor(gfx.kColorWhite)
+    gfx.fillRect(0, 0, 400, 240)
+    gfx.setColor(gfx.kColorBlack)
+    local pic = gfx.image.new("images/player/red-pic-front")
+    if pic then pic:drawScaled(268, 16, 2) end
+    GbFont.drawTight("NAME/" .. Story.playerName(self.game), 16, 20)
+    GbFont.drawTight("MONEY/", 16, 44)
+    GbFont.drawMoneyLine("¥" .. session:inventory():money(), 16 + 16 * 6, 44)
+    GbFont.drawTight("TIME/" .. TitleIdle.playTimeText(clock.hours, clock.minutes), 16, 68)
+    GbFont.drawTight("BADGES", 16, 100)
+    local sheet = gfx.image.new("images/trainer/badges")
+    for index, id in ipairs(TitleIdle.BADGE_FLAGS) do
+        local owned = session:questFlag(id) == true
+        local col = (index - 1) % 4
+        local row = index > 4 and 1 or 0
+        local x = 16 + col * 96
+        local y = 124 + row * 52
+        GbFont.drawTight(tostring(index), x, y + 8)
+        if sheet then
+            local sy = (index - 1) * 32 + (owned and 16 or 0)
+            gfx.setClipRect(x + 20, y, 32, 32)
+            sheet:drawScaled(x + 20, y - sy * 2, 2)
+            gfx.clearClipRect()
+        end
+    end
+    GbFont.drawTight("A / B: Back", 16, 220)
+end
+
