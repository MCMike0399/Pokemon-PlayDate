+-- fidelity-ledger.md Wide Guard row: Gen V rules apply to moves pokered has.
+-- pokered MetronomePickMove rejects Metronome and anything from Struggle up.
+-- B2W2 also refuses these calls. Keys absent from moveData are ignored.
+local metronomeBanned <const> = {
+    afterYou=true, bestow=true, copycat=true, counter=true, covet=true,
+    destinyBond=true, detect=true, endure=true, feint=true, focusPunch=true,
+    followMe=true, helpingHand=true, meFirst=true, metronome=true, mimic=true,
+    mirrorCoat=true, mirrorMove=true, protect=true, quickGuard=true,
+    ragePowder=true, sleepTalk=true, snore=true, struggle=true, switcheroo=true,
+    transform=true, trick=true, wideGuard=true,
+}
+function Battle:metronome(move)
+    local keys = {}
+    for key, definition in pairs(moveData) do
+        if not metronomeBanned[key] and definition and not definition.noPP and definition.name then
+            keys[#keys + 1] = key
+        end
+    end
+    table.sort(keys)
+    self.metronomeEligible = keys
+    if #keys == 0 then
+        self:say("But it failed!")
+        self.conditions:moveFinished(move, false)
+        return nil
+    end
+    local pick = keys[RulesRNG.random(1, #keys)]
+    self.metronomePick = pick
+    return self:performMove(moveData[pick])
+end
+
 -- Keep a bounded, transient diagnostic in addition to the Simulator dev log.
 -- Neither this receipt nor the support inventory owns battle outcomes or saves.
 function Battle:recordMoveGap(key, reason)
@@ -1381,5 +1381,9 @@ function Battle:performMove(move)
     -- Mirror Move spends its own PP, then runs the copied move on this path.
     if self.currentMoveKey=="mirrorMove" then return self:mirrorMove(move) end
+    -- Gen V Metronome calls another move. pokered MetronomePickMove excludes
+    -- Metronome and Struggle; the ledger's Gen V rule also excludes the B2W2
+    -- call ban for moves this table has.
+    if self.currentMoveKey=="metronome" then return self:metronome(move) end
     if handler == "wild-escape" then
