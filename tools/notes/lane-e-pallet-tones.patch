+function WorldView:_composePalletField()
+    if self.zone.stableID ~= "pokered:PALLET_TOWN" then return end
+    local image = gfx.image.new(self.zone.width * TILE_SIZE, self.zone.height * TILE_SIZE, gfx.kColorWhite)
