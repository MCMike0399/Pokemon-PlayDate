+-- Pallet mockup C. Tiles $23, $39 and $2C share one diagonal grass field.
+-- The open center of town, including this comparison window, is the
+-- 192-black-pixel cell (18.8%). A lighter 78-pixel variant of the same
+-- stroke sits on the town border; one tile override cannot select both.
+-- 1-bits in PALLET_GROUND are black. This is not Shade.LIGHT and not
+-- importedTonePatterns. Other quadrants keep the approved Bayer shades.
+local PALLET_GROUND <const> = {
+    0x888A888A, 0x44444444, 0x20222022, 0x00000000,
+    0x80A880A8, 0x40444044, 0x22A222A2, 0x00000000,
+    0x8A888A88, 0x44444444, 0x220A220A, 0x00000000,
+    0x08280828, 0x04040404, 0x2AA22AA2, 0x00000000,
+    0x888A888A, 0x44444444, 0x20222022, 0x00000000,
+    0x80A880A8, 0x40444044, 0x22A222A2, 0x00000000,
+    0x8A888A88, 0x44444444, 0x220A220A, 0x00000000,
+    0x08280828, 0x04040404, 0x2AA22AA2, 0x00000000,
+}
+local PALLET_TONE <const> = { ["23"] = true, ["2c"] = true, ["39"] = true }
+local function palletQuadrants(sourceKey)
+    if type(sourceKey) ~= "string" then return nil end
+    local body = sourceKey:match("^pokered:OVERWORLD:cell:([%da-f]+%-[%da-f]+%-[%da-f]+%-[%da-f]+)$")
+    if not body then return nil end
+    local quads, any = {}, false
+    for id in body:gmatch("[%da-f][%da-f]") do
+        quads[#quads + 1] = id
+        if PALLET_TONE[id] then any = true end
+    end
+    if #quads ~= 4 or not any then return nil end
+    return quads
+end
+local function renderPalletTone(rows, quads, policy)
+    local gfx <const> = playdate.graphics
+    local image = gfx.image.new(32, 32, gfx.kColorWhite)
+    gfx.pushContext(image)
+    for index, id in ipairs(quads) do
+        local col0 = (index - 1) % 2 * 8
+        local row0 = (index - 1) // 2 * 8
+        if PALLET_TONE[id] then
+            local qx = (index - 1) % 2
+            local qy = (index - 1) // 2
+            gfx.setColor(gfx.kColorBlack)
+            for y = 0, 15 do
+                local bits <const> = PALLET_GROUND[qy * 16 + y + 1]
+                for x = 0, 15 do
+                    if (bits >> (31 - (qx * 16 + x))) & 1 == 1 then
+                        gfx.drawPixel(qx * 16 + x, qy * 16 + y)
+                    end
+                end
+            end
+        else
+            for y = 1, 8 do
+                local row = rows[row0 + y]
+                local x = 1
+                while x <= 8 do
+                    local shade = row:sub(col0 + x, col0 + x)
+                    local last = x
+                    while last < 8 and row:sub(col0 + last + 1, col0 + last + 1) == shade do
+                        last = last + 1
+                    end
+                    if shade ~= "." then
+                        if shade == "#" then
+                            gfx.setColor(gfx.kColorBlack)
+                        else
+                            gfx.setPattern(shade == "1" and policy.light or policy.dark, 0, 0)
+                        end
+                        gfx.fillRect((col0 + x - 1) * 2, (row0 + y - 1) * 2, (last - x + 1) * 2, 2)
+                    end
+                    x = last + 1
+                end
+            end
+        end
+    end
+    Shade.reset()
+    gfx.popContext()
+    return image
+end
 local tonePolicy
 function TileRegistry.renderImportedGrid(rows, renderer, sourceKey)
     if tonePolicy == nil then
