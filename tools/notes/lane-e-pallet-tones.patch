+-- Pallet Town grass. Mockup C uses two diagonal strokes, chosen per cell:
+-- the open-center stroke (192 black pixels, 18.8%) and the border stroke
+-- (78 black pixels, 7.6%). PALLET_CENTER_ROW bit (19 - x) is the center
+-- stroke for that map cell, taken from mockup C. 1-bits in the stroke
+-- words are black. $39 draws its source tuft on top of the stroke. $2C
+-- keeps a lighter source-mask lawn stipple, except on a center-stroke
+-- cell, where the quadrant uses that stroke. Roofs, doors, walls and
+-- rooms are not in this set. This is not a global shade.
+local PALLET_CENTER <const> = {
+    0x888A888A, 0x44444444, 0x20222022, 0x00000000,
+    0x80A880A8, 0x40444044, 0x22A222A2, 0x00000000,
+    0x8A888A88, 0x44444444, 0x220A220A, 0x00000000,
+    0x08280828, 0x04040404, 0x2AA22AA2, 0x00000000,
+    0x888A888A, 0x44444444, 0x20222022, 0x00000000,
+    0x80A880A8, 0x40444044, 0x22A222A2, 0x00000000,
+    0x8A888A88, 0x44444444, 0x220A220A, 0x00000000,
+    0x08280828, 0x04040404, 0x2AA22AA2, 0x00000000,
+}
+local PALLET_BORDER <const> = {
+    0x88800000, 0x44400000, 0x22200880, 0x00000000,
+    0x08800222, 0x04400000, 0x00000022, 0x00000000,
+    0x00088000, 0x00044000, 0x22022200, 0x00000000,
+    0x88802200, 0x44400000, 0x20000200, 0x00000000,
+    0x00008888, 0x00004444, 0x88002220, 0x00000000,
+    0x22200000, 0x00000000, 0x08800880, 0x00000000,
+    0x00000088, 0x00000044, 0x02220000, 0x00000000,
+    0x08880222, 0x04440000, 0x00800022, 0x00000000,
+}
+local PALLET_CENTER_ROW <const> = {
+    0x00600, 0x00000, 0x00000, 0x00000, 0x00000, 0x00000,
+    0x04040, 0x07FC0, 0x03FE0, 0x02020, 0x02020, 0x02020,
+    0x03FE0, 0x00000, 0x00000, 0x00000, 0x00000, 0x00000,
+}
+local PALLET_TONE <const> = { ["23"] = true, ["2c"] = true, ["39"] = true }
+local function palletQuadrants(sourceKey)
+    if type(sourceKey) ~= "string" then return nil end
+    local body = sourceKey:match("^pokered:OVERWORLD:cell:([%da-f]+%-[%da-f]+%-[%da-f]+%-[%da-f]+)$")
+    if not body then return nil end
+    local quads, any = {}, false
+    for id in body:gmatch("[%da-f][%da-f]") do
+        quads[#quads + 1] = id
+        if PALLET_TONE[id] then any = true end
+    end
+    if #quads ~= 4 or not any then return nil end
+    return quads
+end
+local function palletCenterCell(x, y)
+    local row = PALLET_CENTER_ROW[y + 1]
+    if row == nil or x < 0 or x > 19 then return false end
+    return (row >> (19 - x)) & 1 == 1
+end
+local function blitStroke(stamp, qx, qy, destX, destY)
+    local gfx <const> = playdate.graphics
+    gfx.setColor(gfx.kColorWhite)
+    gfx.fillRect(destX, destY, 16, 16)
+    gfx.setColor(gfx.kColorBlack)
+    for y = 0, 15 do
+        local bits <const> = stamp[qy * 16 + y + 1]
+        for x = 0, 15 do
+            if (bits >> (31 - (qx * 16 + x))) & 1 == 1 then
+                gfx.drawPixel(destX + x, destY + y)
+            end
+        end
+    end
+end
+local function blitTuft(grid, qx, qy, destX, destY)
+    local gfx <const> = playdate.graphics
+    gfx.setColor(gfx.kColorBlack)
+    for sy = 0, 7 do
+        local row = grid[qy * 8 + sy + 1]
+        for sx = 0, 7 do
+            if row:sub(qx * 8 + sx + 1, qx * 8 + sx + 1) == "1" then
+                gfx.drawPixel(destX + sx * 2, destY + sy * 2)
+            end
+        end
+    end
+end
+-- One black pixel in each source "1" cell. 140 pixels, 13.7%: lighter than
+-- the open-center stroke, and the lawn texture around Oak's Lab.
+local function blitLawnStipple(grid, qx, qy, destX, destY)
+    local gfx <const> = playdate.graphics
+    gfx.setColor(gfx.kColorWhite)
+    gfx.fillRect(destX, destY, 16, 16)
+    gfx.setColor(gfx.kColorBlack)
+    for sy = 0, 7 do
+        local row = grid[qy * 8 + sy + 1]
+        for sx = 0, 7 do
+            if row:sub(qx * 8 + sx + 1, qx * 8 + sx + 1) == "1" then
+                gfx.drawPixel(destX + sx * 2 + 1, destY + sy * 2)
+            end
+        end
+    end
+end
 local tonePolicy
 function TileRegistry.renderImportedGrid(rows, renderer, sourceKey)
     if tonePolicy == nil then
@@ -308,6 +401,37 @@ function TileRegistry:renderImported(value, renderer)
     return store.images[id]
 end
 
+function TileRegistry:paintPalletField(view)
+    local zone = view.zone
+    if zone.stableID ~= "pokered:PALLET_TOWN" then return false end
+    for y = 0, zone.height - 1 do
+        for x = 0, zone.width - 1 do
+            local id = view:tileAt(x, y)
+            local quads = palletQuadrants(self:key(id))
+            if quads then
+                local grid = self:entry(id).grid
+                local center = palletCenterCell(x, y)
+                local stamp = center and PALLET_CENTER or PALLET_BORDER
+                for index, tid in ipairs(quads) do
+                    if PALLET_TONE[tid] then
+                        local qx = (index - 1) % 2
+                        local qy = (index - 1) // 2
+                        local destX = x * 32 + qx * 16
+                        local destY = y * 32 + qy * 16
+                        if tid == "2c" and not center then
+                            blitLawnStipple(grid, qx, qy, destX, destY)
+                        else
+                            blitStroke(stamp, qx, qy, destX, destY)
+                            if tid == "39" then blitTuft(grid, qx, qy, destX, destY) end
+                        end
+                    end
+                end
+            end
+        end
+    end
+    return true
+end
+
 WorldTiles = TileRegistry()
 
