+-- pokered engine/items/item_effects.asm ItemUseBall (af519899).
+-- Source-map throws only. Capture.attempt remains the approved Gen V hybrid
+-- for ordinary wild battles; calling this from attemptSourceCapture conflicts
+-- with that hybrid and with the pinned capture contracts on purpose.
+local function itemUseRng(rng)
+    if type(rng)~="table" or type(rng.snapshot)~="function" or type(rng.restore)~="function" or type(rng.random)~="function" then return nil,"invalid-rng" end
+    local global=rng==RulesRNG
+    local ok,before=pcall(function() return global and rng.snapshot() or rng:snapshot() end)
+    if not ok then return nil,"invalid-rng" end
+    local working=RulesRNG.new(1)
+    if not pcall(working.restore,working,before) then return nil,"invalid-rng" end
+    return working,before,global
+end
+function Capture.itemUseBall(enemyContext, ballId, caughtCount, rng)
+    local input, problem = checked(enemyContext, ballId, caughtCount)
+    if not input then return nil, problem end
+    local working, before, global = itemUseRng(rng)
+    if not working then return nil, before end
+    local result = {catchRate=input.catchRate, ballId=ballId, caught=false, shakeRolls={}, checks=0,
+        successfulChecks=0, displayShakes=0, critical=false, criticalRoll=0, criticalThreshold=0,
+        modifiedRate4096=0, shakeThreshold=0, formula="pokered-item-use-ball"}
+    local function finish()
+        local after=working:snapshot()
+        result.rngRolls=after.rolls-before.rolls
+        if global then rng.restore(after) else rng:restore(after) end
+        return result
+    end
+    if ballId=="masterBall" then
+        result.caught=true
+        result.guaranteed=true
+        result.guarantee="master-ball"
+        result.displayShakes=3
+        return finish()
+    end
+    -- Rand1 is redrawn until it sits in the ball's window.
+    local window=ballId=="pokeBall" and 255 or (ballId=="greatBall" and 200 or 150)
+    local rand1
+    repeat
+        rand1=working:random(0,255)
+    until rand1<=window
+    local status=input.mon.status
+    local statusValue=(status=="sleep" or status=="freeze") and 25 or (status and 12 or 0)
+    local reduced=rand1
+    if statusValue>rand1 then
+        result.caught=true
+    else
+        reduced=rand1-statusValue
+        if reduced>input.catchRate then
+            result.caught=false
+        else
+            local factor=ballId=="greatBall" and 8 or 12
+            local quarter=math.max(input.hp//4,1)
+            local width=(input.maxHP*255)//factor//quarter
+            result.shakeThreshold=math.min(width,255)
+            if width>255 then
+                result.caught=true
+            else
+                local rand2=working:random(0,255)
+                result.shakeRolls[1]=rand2
+                result.checks=1
+                -- cp X, Rand2 / jr c fails when Rand2 > X.
+                result.caught=rand2<=result.shakeThreshold
+            end
+        end
+    end
+    if result.caught then result.displayShakes=3 end
+    result.modifiedRate4096=reduced
+    return finish()
+end
+
