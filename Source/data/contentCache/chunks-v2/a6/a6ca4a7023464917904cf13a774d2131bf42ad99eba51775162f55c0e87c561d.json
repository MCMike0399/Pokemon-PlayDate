{"recipe":[{"op":"text","source_line":2,"text":"MR.FUJI: Heh? You"},{"op":"line","source_line":3,"text":"came to save me?"},{"op":"para","source_line":5,"text":"Thank you. But, I"},{"op":"line","source_line":6,"text":"came here of my"},{"op":"cont","source_line":7,"text":"own free will."},{"op":"para","source_line":9,"text":"I came to calm"},{"op":"line","source_line":10,"text":"the soul of"},{"op":"cont","source_line":11,"text":"CUBONE's mother."},{"op":"para","source_line":13,"text":"I think MAROWAK's"},{"op":"line","source_line":14,"text":"spirit has gone"},{"op":"cont","source_line":15,"text":"to the afterlife."},{"op":"para","source_line":17,"text":"I must thank you"},{"op":"line","source_line":18,"text":"for your kind"},{"op":"cont","source_line":19,"text":"concern!"},{"op":"para","source_line":21,"text":"Follow me to my"},{"op":"line","source_line":22,"text":"home, #MON"},{"op":"cont","source_line":23,"text":"HOUSE at the foot"},{"op":"cont","source_line":24,"text":"of this tower."},{"op":"control","source":"done","source_line":25}],"source":"text/PokemonTower7F.asm"}
