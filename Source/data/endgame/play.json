    "_ChampionsRoomOakDisappointedWithRivalText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 107,
          "text": "OAK: <RIVAL>! I'm"
        },
        {
          "op": "line",
          "source_line": 108,
          "text": "disappointed!"
        },
        {
          "op": "para",
          "source_line": 110,
          "text": "I came when I"
        },
        {
          "op": "line",
          "source_line": 111,
          "text": "heard you beat"
        },
        {
          "op": "cont",
          "source_line": 112,
          "text": "the ELITE FOUR!"
        },
        {
          "op": "para",
          "source_line": 114,
          "text": "But, when I got"
        },
        {
          "op": "line",
          "source_line": 115,
          "text": "here, you had"
        },
        {
          "op": "cont",
          "source_line": 116,
          "text": "already lost!"
        },
        {
          "op": "para",
          "source_line": 118,
          "text": "<RIVAL>! Do you"
        },
        {
          "op": "line",
          "source_line": 119,
          "text": "understand why"
        },
        {
          "op": "cont",
          "source_line": 120,
          "text": "you lost?"
        },
        {
          "op": "para",
          "source_line": 122,
          "text": "You have forgotten"
        },
        {
          "op": "line",
          "source_line": 123,
          "text": "to treat your"
        },
        {
          "op": "cont",
          "source_line": 124,
          "text": "#MON with"
        },
        {
          "op": "cont",
          "source_line": 125,
          "text": "trust and love!"
        },
        {
          "op": "para",
          "source_line": 127,
          "text": "Without them, you"
        },
        {
          "op": "line",
          "source_line": 128,
          "text": "will never become"
        },
        {
          "op": "cont",
          "source_line": 129,
          "text": "a champ again!"
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 130
