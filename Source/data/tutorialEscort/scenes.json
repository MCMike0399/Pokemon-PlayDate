    "_PewterCityYoungsterGoTakeOnBrockText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 74,
          "text": "If you have the"
        },
        {
          "op": "line",
          "source_line": 75,
          "text": "right stuff, go"
        },
        {
          "op": "cont",
          "source_line": 76,
          "text": "take on BROCK!"
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 77
        }
      ],
      "source": "text/PewterCity.asm"
    },
    "_PewterCityYoungsterYoureATrainerFollowMeText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 66,
          "text": "You're a trainer"
        },
        {
          "op": "line",
          "source_line": 67,
          "text": "right? BROCK's"
        },
        {
          "op": "cont",
          "source_line": 68,
          "text": "looking for new"
        },
        {
          "op": "cont",
          "source_line": 69,
          "text": "challengers!"
        },
        {
          "op": "cont",
          "source_line": 70,
          "text": "Follow me!"
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 71
        }
      ],
      "source": "text/PewterCity.asm"
    },
    "_ViridianCityGirlHasntHadHisCoffeeYetText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 46,
          "text": "Oh Grandpa! Don't"
        },
        {
          "op": "line",
          "source_line": 47,
          "text": "be so mean!"
        },
        {
          "op": "cont",
          "source_line": 48,
          "text": "He hasn't had his"
        },
        {
          "op": "cont",
          "source_line": 49,
          "text": "coffee yet."
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 50
        }
      ],
      "source": "text/ViridianCity.asm"
    },
    "_ViridianCityGirlWhenIGoShopText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 53,
          "text": "When I go shop in"
        },
        {
          "op": "line",
          "source_line": 54,
          "text": "PEWTER CITY, I"
        },
        {
          "op": "cont",
          "source_line": 55,
          "text": "have to take the"
        },
        {
          "op": "cont",
          "source_line": 56,
          "text": "winding trail in"
        },
        {
          "op": "cont",
          "source_line": 57,
          "text": "VIRIDIAN FOREST."
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 58
        }
      ],
      "source": "text/ViridianCity.asm"
    },
    "_ViridianCityOldManHadMyCoffeeNowText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 102,
          "text": "Ahh, I've had my"
        },
        {
          "op": "line",
          "source_line": 103,
          "text": "coffee now and I"
        },
        {
          "op": "cont",
          "source_line": 104,
          "text": "feel great!"
        },
        {
          "op": "para",
          "source_line": 106,
          "text": "Sure you can go"
        },
        {
          "op": "line",
          "source_line": 107,
          "text": "through!"
        },
        {
          "op": "para",
          "source_line": 109,
          "text": "Are you in a"
        },
        {
          "op": "line",
          "source_line": 110,
          "text": "hurry?"
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 111
        }
      ],
      "source": "text/ViridianCity.asm"
    },
    "_ViridianCityOldManKnowHowToCatchPokemonText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 114,
          "text": "I see you're using"
        },
        {
          "op": "line",
          "source_line": 115,
          "text": "a #DEX."
        },
        {
          "op": "para",
          "source_line": 117,
          "text": "When you catch a"
        },
        {
          "op": "line",
          "source_line": 118,
          "text": "#MON, #DEX"
        },
        {
          "op": "cont",
          "source_line": 119,
          "text": "is automatically"
        },
        {
          "op": "cont",
          "source_line": 120,
          "text": "updated."
        },
        {
          "op": "para",
          "source_line": 122,
          "text": "What? Don't you"
        },
        {
          "op": "line",
          "source_line": 123,
          "text": "know how to catch"
        },
        {
          "op": "cont",
          "source_line": 124,
          "text": "#MON?"
        },
        {
          "op": "para",
          "source_line": 126,
          "text": "I'll show you"
        },
        {
          "op": "line",
          "source_line": 127,
          "text": "how to then."
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 128
        }
      ],
      "source": "text/ViridianCity.asm"
    },
    "_ViridianCityOldManSleepyPrivatePropertyText": {
      "recipe": [
        {
          "op": "text",
          "source_line": 61,
          "text": "You can't go"
        },
        {
          "op": "line",
          "source_line": 62,
          "text": "through here!"
        },
        {
          "op": "para",
          "source_line": 64,
          "text": "This is private"
        },
        {
          "op": "line",
          "source_line": 65,
          "text": "property!"
        },
        {
          "op": "control",
          "source": "done",
          "source_line": 66
        },
        {
          "op": "control",
          "source": "ViridianCityFisherYouCanHaveThisText::",
          "source_line": 68
        },
        {
          "op": "text",
          "source_line": 69,
          "text": "Yawn!"
        },
        {
          "op": "line",
          "source_line": 70,
          "text": "I must have dozed"
