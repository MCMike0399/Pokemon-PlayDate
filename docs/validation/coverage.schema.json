{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current coverage separates path, regional fidelity and full mechanics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "schedule",
    "milestones",
    "owners",
    "evidence",
    "source_inventory_summary",
    "source_limits",
    "rows",
    "staged_source_snapshots",
    "limits",
    "accepted_milestone_rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot": {
      "type": "object"
    },
    "schedule": {
      "type": "object"
    },
    "milestones": {
      "type": "object"
    },
    "owners": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "source_inventory_summary": {
      "type": "object"
    },
    "source_limits": {
      "type": "array"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "staged_source_snapshots": {
      "type": "array"
    },
    "limits": {
      "type": "array"
    },
    "accepted_milestone_rows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "verification",
        "evidence",
        "notes"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "indexed",
            "partial",
            "integrated",
            "not_applicable"
          ]
        },
        "verification": {
          "enum": [
            "unreviewed",
            "unrun",
            "source_only",
            "host",
            "sdk_scoped",
            "native_scoped",
            "accepted_milestone"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "owner",
        "dependencies",
        "due_milestone",
        "source",
        "campaign_path",
        "regional_fidelity",
        "full_mechanics",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "map_slot",
            "system",
            "move",
            "ability",
            "species",
            "item",
            "held_native",
            "audio_source"
          ]
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "due_milestone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaign_path",
            "regional_fidelity",
            "full_mechanics"
          ],
          "properties": {
            "campaign_path": {
              "type": "string"
            },
            "regional_fidelity": {
              "type": "string"
            },
            "full_mechanics": {
              "type": "string"
            }
          }
        },
        "source": {
          "type": "object"
        },
        "notes": {
          "type": "string"
        },
        "staged": {
          "type": "object"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "campaign_path": {
          "$ref": "#/$defs/facet"
        },
        "regional_fidelity": {
          "$ref": "#/$defs/facet"
        },
        "full_mechanics": {
          "$ref": "#/$defs/facet"
        }
      }
    }
  }
}
