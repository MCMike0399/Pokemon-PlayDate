@@ -161,7 +166,7 @@
     end
     local function canStand(spec,x,y,runtimeZone)
         local cell = y * surface.width + x + 1
-        if spec.script_positions[cell] and not protected[cell] and x >= 0 and y >= 0 and x < surface.width and y < surface.height
